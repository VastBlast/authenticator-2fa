{
  "name": "authenticator-2fa",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-extension.mjs",
    "build:check": "pnpm run check && pnpm run test && pnpm run build",
    "build:prod": "vite build --mode production && node scripts/build-extension.mjs",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "store:screenshots": "pnpm run build && node scripts/generate-store-screenshots.mjs",
    "lint": "oxlint --type-aware",
    "check": "pnpm run lint && pnpm run test:types && svelte-check --tsconfig ./tsconfig.json",
    "test": "pnpm run check && vitest run",
    "test:types": "tsc -p tsconfig.test.json",
    "clean": "node scripts/clean.mjs",
    "package": "pnpm run clean && pnpm run build:prod && node scripts/package-extension.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.55.0",
    "qrcode": "^1.5.4",
    "tldts": "^7.4.18",
    "zxing-wasm": "^3.1.5"
  },
  "devDependencies": {
    "@sveltejs/mcp": "^0.1.26",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "daisyui": "^5.7.47",
    "fflate": "^0.8.3",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
